# SQLite works immediately. Use the PostgreSQL URL when running Docker Compose.
DATABASE_URL=sqlite:///./agentforge.db
AGENTFORGE_ENV=development
AGENTFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required before starting OAuth. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the value stable and private; changing it makes stored credentials unreadable.
AGENTFORGE_MASTER_KEY=
OAUTH_SESSION_TTL_SECONDS=600
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

# Optional model providers (not required by the mock vertical slice).
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Reserved for the background worker milestone.
REDIS_URL=redis://localhost:6379/0
